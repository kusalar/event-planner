# ==============================================================================
# EVENTORA AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development, or set these variables
# in your Vercel Project Settings > Environment Variables.
# ==============================================================================

# Google Gemini API Key (Server-side only — never exposed to client bundles)
GEMINI_API_KEY="your-gemini-api-key-here"

# Supabase Project URL (Root project URL — do NOT append /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase Anonymous Publishable Key (Client-safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key-here"
